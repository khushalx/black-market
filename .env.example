# Local database. These credentials are development-only; replace for deployment.
DATABASE_URL=postgres://blackmarket:blackmarket@127.0.0.1:54329/blackmarket
PORT=2567
NEXT_PUBLIC_WS_URL=http://localhost:2567
# Server-only Next.js rewrite destination. Set this when deploying web separately.
API_ORIGIN=http://127.0.0.1:2567
APP_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
# Number of trusted reverse-proxy hops (0 for direct access; usually 1 behind a proxy).
TRUST_PROXY_HOPS=0
# Optional authoritative ranked timing overrides. Defaults: 10, 30, 3 seconds.
# RANKED_PREVIEW_SECONDS=10
# RANKED_AUCTION_SECONDS=30
# RANKED_RESULT_SECONDS=3
# Set a random secret of at least 32 characters on a deployed server.
SESSION_SECRET=replace-with-a-long-random-deployment-secret
